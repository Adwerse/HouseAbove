# MongoDB Atlas M0 (database "homesabove")
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# TensorX (OpenAI-compatible, EU-hosted). All model inference goes through it.
TENSORX_API_KEY=
TENSORX_BASE_URL=

# Output of pipeline/probe_providers.py. VISION_MODEL and VERIFIER_MODEL must be different families.
VISION_MODEL=
VERIFIER_MODEL=
AGENT_MODEL=
EMBED_MODEL=
EMBED_DIM=

# 0 | 1
DEMO_CACHE=0

# Read by web/ (Vite): api | static
VITE_DATA_MODE=api
VITE_DEMO_WALKER=w_rodion
